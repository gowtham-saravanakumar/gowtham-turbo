# PostgreSQL connection string. Render provides this from a managed PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Use a long random value in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Seed administrator credentials. Change these before running db:seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Render sets PORT automatically. Local default is 10000.
PORT=10000
NODE_ENV=development
